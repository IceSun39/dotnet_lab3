<Window x:Class="dotnet_lab3.MainWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:local="clr-namespace:dotnet_lab3"
mc:Ignorable="d"
Title="MainWindow" Height="450" Width="800">
    <Grid>
        <!-- Група 1: Форма введення -->
        <GroupBox Header="Працівник" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="33,25,0,0" Width="718" Height="165"/>
        <Label Content="Роль" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="45,55,0,0"/>

        <!-- Додано Проджект Менеджера -->
        <ComboBox x:Name="typeSpecialistComboBox" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="95,57,0,0" Width="140" SelectedIndex="0" SelectionChanged="typeSpecialistComboBox_SelectionChanged">
            <ComboBoxItem Content="Дизайнер"/>
            <ComboBoxItem Content="Програміст"/>
            <ComboBoxItem Content="Проджект Менеджер"/>
        </ComboBox>

        <Label x:Name="titleLabel" Content="Посада" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="255,55,0,0"/>
        <TextBox x:Name="titleTextBox" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="315,59,0,0" Width="130" Height="22"/>

        <Label Content="Роки досвіду" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="465,55,0,0"/>
        <TextBox x:Name="experienceTextBox" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="555,59,0,0" Width="80" Height="22"/>

        <Label Content="Часова ставка" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="45,100,0,0"/>
        <TextBox x:Name="hourRateTextBox" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="145,104,0,0" Width="70" Height="22"/>

        <Label x:Name="specializationLabel" Content="Спеціалізація" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="235,100,0,0"/>
        <TextBox x:Name="specializationTextBox" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="325,104,0,0" Width="120" Height="22"/>

        <ComboBox x:Name="levelComboBox" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="325,104,0,0" Width="120" SelectedIndex="0">
            <ComboBoxItem Content="Джун"/>
            <ComboBoxItem Content="Сеньйор"/>
        </ComboBox>

        <Label Content="Години роботи" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="460,100,0,0"/>
        <TextBox x:Name="hoursWorkedTextBox" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="565,104,0,0" Width="100" Height="22"/>

        <Button Content="Додати працівника" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="45,145,0,0" Width="140" Height="26" Click="Button_Click"/>

        <!-- Група 2: Список працівників -->
        <GroupBox Header="Список працівників" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="33,205,0,0" Width="718" Height="140">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="allEmployeesLabel" Margin="10" TextWrapping="Wrap"/>
            </ScrollViewer>
        </GroupBox>

        <!-- Підсумок -->
        <Label Content="Загальна зарплата:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="33,355,0,0" FontWeight="Bold"/>
        <Label x:Name="totalSalaryLabel" Content="0 грн" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="160,355,0,0" FontWeight="Bold"/>
        <!-- Група 3: Команди -->
        <GroupBox Header="Управління командами" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="33,390,0,0" Width="718" Height="110">
            <Grid>
                <Label Content="PM:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,20,0,0"/>
                <ComboBox x:Name="pmComboBox" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="60,22,0,0" Width="150"/>

                <Label Content="Працівник:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="230,20,0,0"/>
                <ComboBox x:Name="employeeComboBox" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="310,22,0,0" Width="150"/>

                <!-- Кнопка додавання -->
                <Button Content="Додати до команди" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="490,22,0,0" Width="150" Height="22" Click="AddToTeamButton_Click"/>

                <!-- НОВА Кнопка перегляду команди -->
                <Button Content="Показати команду" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="490,55,0,0" Width="150" Height="22" Click="ShowTeamButton_Click"/>
            </Grid>
        </GroupBox>
    </Grid>
</Window>